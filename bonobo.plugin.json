{
	"schemaVersion": 1,
	"name": "data-probe",
	"displayName": "Data Probe",
	"version": "0.3.0",
	"description": "Checks backend replies, response limits, no-op uploads, and saved plugin documents after failure. Also a QA fixture for the chat agent: one MCP server with an echo tool and one skill. No secrets.",
	"compatibility": {
		"bonoboPluginRuntime": "1"
	},
	"backend": {
		"entry": "dist/backend/worker.js",
		"moduleName": "plugin.js",
		"compatibilityDate": "2026-07-01",
		"compatibilityFlags": ["nodejs_compat"],
		"endpoints": [
			{ "id": "probe", "path": "/probe", "serialization": "installation" }
		]
	},
	"configuration": {
		"description": "Choose which upload folders the probe records.",
		"defaultYaml": "triggers:\n  files.upload.completed:\n    folders:\n      - /\n"
	},
	"events": [
		{
			"type": "files.upload.completed",
			"contentTypes": ["image/png"],
			"filters": [
				{
					"field": "source.path",
					"operator": "pathIsUnderAny",
					"configurationPath": ["triggers", "files.upload.completed", "folders"]
				}
			]
		}
	],
	"pages": [
		{
			"id": "data-probe",
			"title": "Data Probe",
			"entry": "dist/frontend/index.html",
			"navItem": {
				"label": "Data Probe",
				"icon": "database"
			}
		}
	],
	"capabilities": [
		"plugin.data.read",
		"plugin.data.write",
		"plugin.backend.invoke",
		"agent.mcp.connect",
		"agent.skills.contribute"
	],
	"outboundOrigins": [],
	"mcpServers": [
		{
			"id": "fixture",
			"title": "MCP fixture",
			"transport": "http",
			"url": "https://bonobo-senate-mcp-fixture.ray-thurne-void.workers.dev/modern-basic",
			"headers": [],
			"auth": { "kind": "none" },
			"tools": null
		}
	],
