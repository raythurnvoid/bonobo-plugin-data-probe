{
	"schemaVersion": 1,
	"name": "data-probe",
	"displayName": "Data Probe",
	"version": "0.1.0",
	"description": "Records one plugin-data document per upload and reads them back on its page.",
	"compatibility": {
		"bonoboPluginRuntime": "1"
	},
	"backend": {
		"entry": "dist/backend/worker.js",
		"moduleName": "plugin.js",
		"compatibilityDate": "2026-07-01",
		"compatibilityFlags": ["nodejs_compat"]
	},
	"configuration": {
		"description": "Choose which upload folders the probe records.",
		"defaultYaml": "triggers:\n  files.upload.completed:\n    folders:\n      - /\n"
	},
	"events": [
		{
			"type": "files.upload.completed",
			"contentTypes": ["text/plain", "text/markdown", "application/json", "image/png", "image/jpeg"],
			"filters": [
				{
					"field": "source.path",
					"operator": "pathIsUnderAny",
					"configurationPath": ["triggers", "files.upload.completed", "folders"]
				}
			]
		}
	],
	"pages": [
		{
			"id": "data-probe",
			"title": "Data Probe",
			"entry": "dist/frontend/index.html",
			"navItem": {
				"label": "Data Probe",
				"icon": "database"
			}
		}
	],
	"capabilities": ["plugin.data.read", "plugin.data.write"],
	"outboundOrigins": [],
	"files": [
		{
			"path": "dist/backend/worker.js",
			"sha256": "sha256:f63a4e96da03dab9d7684c59f38f3a8df886c5c329505587e7d36b965a60a077",
			"bytes": 2377,
