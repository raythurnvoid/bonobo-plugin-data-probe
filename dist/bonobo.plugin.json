{
	"schemaVersion": 1,
	"name": "data-probe",
	"displayName": "Data Probe",
	"version": "0.6.0",
	"description": "Checks backend replies, saved plugin documents, Trash restore, scheduled permission limits, revocation, and the backend outbound origin check. Also a QA fixture for the chat agent: one MCP server with an echo tool and one skill. No secrets.",
	"compatibility": {
		"bonoboPluginRuntime": "1"
	},
	"backend": {
		"entry": "dist/backend/worker.js",
		"moduleName": "plugin.js",
		"compatibilityDate": "2026-07-01",
		"compatibilityFlags": ["nodejs_compat"],
		"endpoints": [
			{ "id": "probe", "path": "/probe", "serialization": "installation" }
		]
	},
	"configuration": {
		"description": "Choose upload folders and one scheduled QA check.",
		"defaultYaml": "triggers:\n  files.upload.completed:\n    folders:\n      - /\nschedule:\n  everyMinutes: 10080\ndiagnostic:\n  case: idle\n"
	},
	"events": [
		{
			"type": "files.upload.completed",
			"contentTypes": ["image/png"],
			"filters": [
				{
					"field": "source.path",
					"operator": "pathIsUnderAny",
					"configurationPath": ["triggers", "files.upload.completed", "folders"]
				}
			]
		},
		{
			"type": "schedule.interval.elapsed",
			"schedule": { "configurationPath": ["schedule", "everyMinutes"] }
		}
	],
	"pages": [
		{
			"id": "data-probe",
			"title": "Data Probe",
			"entry": "dist/frontend/index.html",
			"navItem": {
				"label": "Data Probe",
				"icon": "database"
			}
		}
	],
	"capabilities": [
		"plugin.data.read",
		"plugin.data.write",
		"workspace.files.read",
		"workspace.files.write",
		"workspace.files.restore",
		"plugin.schedule.run",
		"plugin.backend.invoke",
		"outbound.fetch",
		"agent.mcp.connect",
		"agent.skills.contribute"
	],
	"outboundOrigins": ["https://*.ray-thurne-void.workers.dev"],
	"mcpServers": [
		{
			"id": "fixture",
			"title": "MCP fixture",
			"transport": "http",
			"url": "https://bonobo-senate-mcp-fixture.ray-thurne-void.workers.dev/modern-basic",
			"headers": [],
			"auth": { "kind": "none" },
			"tools": null
		}
	],
	"files": [
